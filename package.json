{
  "name": "uchi-timeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run bundle:api",
    "bundle:api": "esbuild server/vercel-entry.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/timeline.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "eval:live": "tsx eval/run.ts --live",
    "eval:ai": "tsx eval/run.ts --real",
    "verify:ui": "tsx scripts/verify-ui.ts"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
